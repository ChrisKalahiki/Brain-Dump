{
  "name": "brain-dump",
  "private": true,
  "type": "module",
  "bin": {
    "brain-dump": "src/cli.ts"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "check": "bun run typecheck && bun test",
    "test": "bun test",
    "test:file": "bun test",
    "typecheck": "tsc --noEmit",
    "prompts": "bun src/prompts.ts",
    "eval": "bun evals/run.ts",
    "eval:check": "bun evals/check.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
